# IkerCare 2.0 - ejemplo. Nunca subas tu .env real al repositorio.
APP_PORT=8080
APP_TIMEZONE=America/Santiago
PUBLIC_BASE_URL=http://localhost:8080

# Base de datos local Docker. En Render/Neon usa DATABASE_URL directamente.
POSTGRES_DB=iker_care
POSTGRES_USER=iker_care
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql+psycopg://iker_care:cambia-esta-clave@db:5432/iker_care

# Sesiones. Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-por-una-clave-aleatoria-larga
COOKIE_SECURE=false

# Cifrado de documentos/fotos: 32 bytes en base64 url-safe.
# Genera con: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Usuario legado inicial; V2 permite registrar múltiples cuentas.
ADMIN_USERNAME=alexis
ADMIN_PASSWORD=cambia-esta-clave
CHILD_NAME=Paciente
HOSPITAL_NAME=
SEED_SAMPLE_DATA=true

# Límites de documentos
MAX_UPLOAD_MB=12
OCR_MAX_PAGES=8

# Opcional: solo para redactar la narrativa de Reportes usando hechos ya guardados en IkerCare.
# Configura esta variable como secreto en Render; nunca subas una clave real al repositorio.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-5-mini
